# Local demo: read-only unless an admin key is set. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-random-url-safe-password
POLICYLENS_DEMO_MODE=true
POLICYLENS_API_KEY=
POLICYLENS_ADMIN_KEY=
POLICYLENS_ENABLE_RERANKER=false
POLICYLENS_PROVIDER=extractive
# Optional local LLM: ollama pull llama3.2:3b, then set provider=ollama.
POLICYLENS_OLLAMA_URL=http://localhost:11434
POLICYLENS_OLLAMA_MODEL=llama3.2:3b
